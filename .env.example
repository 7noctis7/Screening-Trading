# Copiez ce fichier en `.env` (jamais committé) et renseignez vos clés.
# Aucune clé ici n'est obligatoire : sans elles, tout tourne en paper / synthétique.

# --- Alpaca (actions & ETF US, PAPER) ---
# Créez un compte PAPER sur https://alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Bitmart (crypto, paires /USDC) ---
# https://www.bitmart.com → Account → API Management (permissions: lecture + spot trade ; JAMAIS retrait)
BITMART_API_KEY=
BITMART_API_SECRET=
BITMART_API_MEMO=
# Marché de trading Bitmart : "spot" (défaut, SANS levier — recommandé) ou "swap" (futures = LEVIER).
# ⚠️ Le futures introduit du levier → risque de ruine, contraire à la discipline du système. Spot conseillé.
# BITMART_MARKET=spot
# Poche CRYPTO (risk-parity) : BUDGET en part du compte — défaut 0.15 (15 % crypto au plus,
# 85 % actions + cœur). 0 = pas de crypto. Une poche sous-investie laisse sa part en cash.
# Ère paper : la crypto part sur le compte Alpaca (ADR-0029). Cf. QML-023.
# QUANT_CRYPTO_PCT=0.15

# --- Données fondamentales réelles (optionnel) ---
# Option A : FMP (clé, free tier ≈40 actifs) — https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# Option B : yfinance (RÉEL, GRATUIT, sans clé) = MAINTENANT LE DÉFAUT quand le réseau répond.
#   Cache disque 24 h (.cache/) → builds rapides ; le cron quotidien le réchauffe.
#   Pour FORCER l'offline/démo (fondamentaux synthétiques) : QUANT_FUND=synthetic
# QUANT_FUND=synthetic

# --- Stratégie (best practice — cf. ADR-0023 ; DSR≈0 → satellite risk-managed + cœur QQQ) ---
# QUANT_DD_TARGET=0.25      # DD-cible du preset : 0.15 max-défensif · 0.25 défaut · 0.45 agressif
# QUANT_CORE_SPEC=qqq:0.5   # cœur indiciel (bêta honnête) ; ex. qqq:0.15,megacap:0.10 — le reste = preset

# --- Base de prix réelle (optionnel) ---
# QUANT_PRICE_DB=/Users/votre_nom/Desktop/YAHOO.db
# Profondeur d'historique (jours). Défaut 1700 (~4,6 ans). Pour remonter à ~2016 : 3650 (~10 ans).
# QUANT_HISTORY_DAYS=3650

# --- News réelles (optionnel) : mettre 1 pour activer le flux RSS gratuit ---
# QUANT_NEWS=1
# Modèle NLP : FinBERT générique par défaut. RECOMMANDÉ (meilleur, gratuit) si transformers installé :
# FINBERT_MODEL=yiyanghkust/finbert-tone

# --- Macro chiffrée (optionnel, GRATUIT) : clé FRED → onglet Macro (croissance, inflation, taux…) ---
# https://fred.stlouisfed.org → My Account → API Keys
# FRED_API_KEY=

# --- Alerte earnings (optionnel) : 1 = signale les résultats imminents sur les positions ---
# QUANT_EARNINGS=1

# --- Canaux d'alerte ops (optionnel) : réconciliation broker↔DB, fills partiels, kill-switch ---
# Sans clés, la Console reste le canal par défaut (les alertes restent visibles en local).
# Telegram : créez un bot via @BotFather → token ; chat_id via @userinfobot.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# Discord : Salon → Paramètres → Intégrations → Webhooks → Nouveau webhook → copier l'URL.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# --- IA : VOTRE fournisseur, VOTRE clé ---
# « Compatible OpenAI » désigne un FORMAT DE REQUÊTE devenu standard, pas le fournisseur. Google,
# Mistral, Groq et les autres l'acceptent tous sur leurs propres serveurs, avec leurs propres
# clés. Choisir Gemini envoie vos requêtes chez Google, et nulle part ailleurs.
# La clé est lue depuis CETTE machine uniquement. Elle n'est jamais demandée dans le navigateur
# ni transmise ailleurs : sur une instance auto-hébergée, elle ne quitte pas votre poste.
# Sans clé, seul un modèle LOCAL fonctionne (LM Studio / Ollama n'en réclament pas).
#
#   local (défaut)  LLM_BASE_URL=http://localhost:1234/v1        + aucune clé
#   OpenAI          LLM_BASE_URL=https://api.openai.com/v1       + LLM_API_KEY=sk-...
#   Anthropic       LLM_BASE_URL=https://api.anthropic.com/v1    + LLM_API_KEY=sk-ant-...
#   Mistral         LLM_BASE_URL=https://api.mistral.ai/v1       + LLM_API_KEY=...
#   Gemini (Google) LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                   LLM_API_KEY=AIza...          (clé GOOGLE AI Studio, pas une clé OpenAI)
#                   LLM_MODEL=gemini-2.5-flash   (ou gemini-2.5-pro)
#
#                   ATTENTION AU MALENTENDU : le « /openai » à la fin de cette URL n'est PAS
#                   OpenAI. Le domaine est celui de Google (generativelanguage.googleapis.com)
#                   et « openai » est simplement le nom que Google donne à SA couche de
#                   compatibilité — Google accepte le format de requête popularisé par OpenAI,
#                   devenu le format standard du secteur. Vos requêtes vont chez Google, avec
#                   votre clé Google. Aucune donnée ne transite par OpenAI.
#
#                   L'autre URL de Google (/v1beta/models, l'API Gemini « native ») parle un
#                   protocole différent — ce client ne la comprendrait pas.
#   Groq, DeepSeek, OpenRouter, together.ai… : même principe, seule l'URL change.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=
# LLM_MODEL=
# Ollama (FinOps : décharge les tâches simples sur un modèle local gratuit) :
# OLLAMA_HOST=http://127.0.0.1:11434
# QUANT_LOCAL_LLM=gemma3n:e4b           # modèle local pour cheap_llm/smart_text (ollama pull gemma3n:e4b)
# QUANT_EMBED=ollama                    # RAG vault dense (ollama pull nomic-embed-text)

# --- Miroir Obsidian → Notion (gratuit, scripts/notion_sync.py) ---
# Intégration : notion.so → My integrations → secret ; partager la page parente avec l'intégration.
# NOTION_TOKEN=ntn_xxxxxxxxxxxx
# NOTION_PARENT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # ID (32 hex) de la page Notion parente

# --- Historique KPIs cloud Supabase (gratuit, scripts/kpi_to_supabase.py) ---
# Projet Supabase → Settings → API : URL + clé (service_role conseillée si RLS activé).
# Table SQL : create table daily_kpis(date date primary key, total_return float8, cagr float8,
#   sharpe float8, sortino float8, calmar float8, max_drawdown float8, win_rate float8,
#   profit_factor float8, expectancy float8, p_ruin float8);
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_KEY=eyJxxxxxxxx

# --- Sécurité API (durcissement) ---
# CORS verrouillé sur localhost par défaut. N'élargir QUE si tu exposes l'API (jamais "*" en réseau ouvert) :
# QUANT_CORS_ORIGINS=https://mon-domaine.example
# Jeton pour le webhook TradingView (/api/tv/webhook). Si vide → endpoint accessible UNIQUEMENT en localhost.
# QUANT_WEBHOOK_TOKEN=change-moi-en-chaine-aleatoire-longue

# --- Cache OHLCV Hugging Face (gratuit, versionné) ---
# Dataset PUBLIC → lecture sans token (CI) ; seul le `make hf-push` (rafraîchissement) requiert le token.
# Token fine-grained limité au seul dataset (Write). Ne JAMAIS committer .env (gitignoré + gitleaks).
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# HF_DATASET=Noctis777/screening-trading-cache


# =============================================================================
#  AUTO-HÉBERGEMENT — chaque utilisateur fait tourner SON instance, avec SES clés
# =============================================================================
# Rien ne transite par un serveur tiers : les clés restent dans ce fichier, sur cette machine.
# `.env` est gitignoré — vérifiez-le avant tout `git add`.
#
# CE FICHIER NE CONTIENT AUCUNE VRAIE CLÉ. Copiez-le en `.env` et remplissez ce dont vous
# avez besoin ; tout est facultatif, l'outil démarre sans rien (en données de démonstration).

# --- Comptes de courtage (facultatif — sans eux, tout reste en simulation) ---
# Actions & ETF (Alpaca, compte PAPER par défaut — ne jamais mettre des clés « live » ici
# sans savoir ce que vous faites) :
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# Crypto — la place est un CHOIX (cf. packages/execution/venues.py) :
# QUANT_CRYPTO_VENUE=binance            # binance (défaut, taker 0,10 %) | bitmart
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# QUANT_BINANCE_TESTNET=1               # 1 = bac à sable officiel. Passez à 0 EN CONNAISSANCE DE CAUSE.

# --- Garde-fous d'exécution ---
# QUANT_MIN_POSITION=1000               # plancher par ligne : sous ce montant, aucune position
#                                       # n'est ouverte, et une cible en dessous vaut zéro.
# QUANT_DD_TARGET=                      # baisse maximale visée. Laissez vide pour la valeur issue
#                                       # de votre profil d'investisseur (packages/profile).
# QUANT_ATTENTE_FILLS_S=90              # délai MAX d'attente, après l'envoi, que le courtier
#                                       # rende les ordres comme exécutés — avant de les
#                                       # journaliser. Sans elle, on lit un compte qui n'a pas
#                                       # fini d'exécuter : le 22/09, 4 achats sur 6 perdus et
#                                       # 2 tronqués (22 695,70 $ de prix de revient absent).
#                                       # `0` désarme l'attente (ancien comportement).

# --- Mise à jour du code ---
# QUANT_BRANCH=main                     # branche suivie par `make start`. `main` porte ce qui est
#                                       # mergé — n'en changez que si vous savez pourquoi.
# QUANT_NO_UPDATE=1                     # empêche `make start` de mettre le code à jour.

# --- Données de prix ---
# QUANT_PRICE_DB=/chemin/vers/YAHOO.db  # détecté automatiquement par `make setup` si présent.
# QUANT_HISTORY_DAYS=4015               # ~11 ans d'historique.

# RAPPEL. Passer des ordres RÉELS exige `--live --yes` ET des clés présentes. Le mode simulation
# (« paper ») est le défaut, et il le reste tant que vous ne demandez pas explicitement l'inverse.

# ─────────────────────────────────────────────────────────────────────────────
# PORTAIL DE RISQUE PRÉ-TRADE (packages/risk/order_gate.py)
# ─────────────────────────────────────────────────────────────────────────────
# Dernière barrière avant le courtier. Ces limites sont lues ICI et NULLE PART ailleurs :
# aucune couche amont (stratégie, IA) ne peut les desserrer en passant un argument.
#
# Le portail ne peut que RÉDUIRE ou REFUSER un ordre, jamais l'augmenter. Et un désengagement
# (vente, liquidation) n'est JAMAIS bloqué : un portail qui refuse une sortie augmente le risque.
#
# Une valeur illisible ou négative retombe sur le défaut — une faute de frappe ne doit pas
# désactiver silencieusement un garde-fou.

# Poids maximal d'une ligne, en fraction du compte (0.20 = 20 %).
QUANT_RISK_MAX_WEIGHT=0.20

# Nombre maximal de positions. Au-delà : plus aucune OUVERTURE (les allègements restent possibles).
QUANT_RISK_MAX_POSITIONS=40

# Taille maximale d'un ordre, en fraction du compte (0.15 = 15 %).
QUANT_RISK_MAX_ORDER_PCT=0.15

# Exposition brute maximale, en fraction du compte. 1.00 = AUCUN LEVIER, JAMAIS.
# Ne pas monter au-dessus de 1.00 : le projet n'est pas conçu pour le levier.
QUANT_RISK_MAX_GROSS=1.00

# ─────────────────────────────────────────────────────────────────────────────
# INTERACTIVE BROKERS — COMPTE DÉMO UNIQUEMENT (packages/execution/ibkr_broker.py)
# ─────────────────────────────────────────────────────────────────────────────
# Ce courtier ne peut PAS passer d'ordre sur un compte IBKR réel. Trois verrous indépendants :
# le port (7496/4001 = réel → refusés), l'identifiant de compte renvoyé par la passerelle
# (« DU… »/« DF… » = démo ; tout le reste est refusé, y compris un identifiant vide), et
# l'opt-in ci-dessous.
#
# Il n'existe AUCUNE variable qui ouvrirait le réel. En ajouter une exigerait de modifier le
# fichier source — donc un geste visible et tracé dans l'historique git.
#
# Prérequis : `pip install ib_insync`, puis TWS ou IB Gateway lancé en mode PAPIER, avec l'API
# activée (Global Configuration → API → Enable ActiveX and Socket Clients).

# Active le courtier IBKR. Absent ou différent de 1 → courtier non configuré.
QUANT_IBKR_ENABLE=0

# Port d'écoute de la passerelle. 7497 = TWS papier · 4002 = IB Gateway papier.
# 7496 et 4001 sont les ports RÉELS : le module les refuse.
QUANT_IBKR_PORT=7497

QUANT_IBKR_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# ONGLET X (/x) — publications des comptes suivis
# ---------------------------------------------------------------------------
# Le flux est ALIMENTÉ, jamais deviné : tant qu'aucune source n'a tourné, l'onglet
# affiche « flux non connecté » plutôt que des messages inventés. Ingestion :
#     make x-ingest                     (source « fichier », data/x_posts.jsonl)
#     make x-ingest ARGS=--etat         (ce que le store contient, sans rien écrire)
#
# QUANT_SOCIAL_DB=data/social_x.db   # base des publications (jamais versionnée)
# QUANT_X_JSONL=data/x_posts.jsonl   # export lu par la source « fichier »
#
# SOURCE RSS (gratuite). Le palier libre de l'API X ne permet PAS de lire — il sert à
# publier. Les voies sans frais passent par un tiers qui expose du RSS (instance Nitter
# survivante, xcancel, RSSHub, RSS.app). Ces miroirs MEURENT régulièrement : aucune URL
# n'est codée dans le module, on en change ici. Un miroir mort est NOMMÉ dans le rapport
# d'ingestion, jamais confondu avec « ce compte n'a rien publié ».
# QUEL MIROIR RÉPOND AUJOURD'HUI ? Ça se MESURE, ça ne se lit pas dans une doc — ces
# instances meurent en permanence. Le sondeur essaie plusieurs candidats × vos comptes
# et rend la ligne à coller ici :
#     make x-miroirs
#     make x-ingest ARGS="--source rss"
# QUANT_X_RSS=https://<miroir>/astekz/rss,https://<miroir>/trendspider/rss
#
# LA VOIE DURABLE : RSSHUB AUTO-HÉBERGÉ. Les miroirs publics meurent ; un RSSHub sur
# VOTRE machine ne dépend que d'X. Il lit avec le cookie `auth_token` d'une session x.com
# — celui d'un compte SECONDAIRE, JAMAIS le principal : les conditions d'X interdisent
# la lecture automatisée, et ce compte peut être limité. Le cookie ne va PAS ici (dépôt
# public) : `make rsshub ARGS=jeton` le demande en saisie MASQUÉE — jamais en argument,
# qui le laisserait dans l'historique du shell — et l'écrit en 0600 hors du dépôt.
# `make rsshub` refuse de démarrer si ce fichier est lisible par d'autres, et n'écoute
# que sur 127.0.0.1.
#     make rsshub ARGS=jeton && make rsshub && make rsshub ARGS=statut
# `includeRts=0` écarte les retweets : sans lui, le signal d'un tiers repris par astekz
# serait rangé comme un signal d'astekz (AGENTS.md §9 — une reprise n'est pas une source).
# QUANT_X_RSS=http://127.0.0.1:1200/twitter/user/astekz/includeRts=0,http://127.0.0.1:1200/twitter/user/trendspider/includeRts=0,http://127.0.0.1:1200/twitter/user/micro2macr0/includeRts=0
#
# TROISIÈME VOIE, qui ne dépend d'AUCUN tiers : l'export depuis votre propre navigateur,
# où vous êtes déjà connecté. `make x-export` rend un marque-page ; un clic sur un profil
# X télécharge x_posts.jsonl. Aucune clé, aucun miroir, rien qui puisse mourir.
#     make x-export
#     mv ~/Downloads/x_posts.jsonl data/x_posts.jsonl && make x-ingest
#
# TELEGRAM — la voie la plus solide des trois, et celle à préférer. `t.me/s/<canal>` est
# une page PUBLIQUE servie par Telegram : aucune clé, aucun compte, aucun risque. Deux
# canaux trouvés le 24/09 pour les comptes suivis.
#
# LE CANAL N'EST PAS LE COMPTE : « crypto_eliz883 » est le compte X « eliz883 ». La
# syntaxe `canal:compte` range les messages sous le pseudo que vous filtrez ; sans elle,
# le filtre par compte afficherait des noms de canaux que vous ne reconnaîtriez pas.
#     make x-ingest ARGS="--source telegram"
# QUANT_TG_CANAUX=crypto_eliz883:eliz883,walshwealth1122
#
# RÉTENTION — seules les N publications les plus récentes DE CHAQUE COMPTE sont gardées,
# les autres sont SUPPRIMÉES à chaque ingestion (irréversible). Par compte, pas au total :
# un plafond global laisserait le compte le plus bavard évincer les autres. 0 = tout garder.
# QUANT_SOCIAL_GARDER=50
#
# DISCORD — API BOT officielle. AVOIR REJOINT UN SERVEUR NE SUFFIT PAS : un bot ne voit
# que les serveurs où un administrateur l'a invité. Deux voies propres :
#   1. le serveur vous appartient, ou son admin accepte d'ajouter votre bot ;
#   2. le salon est de type ANNONCES → le SUIVRE depuis votre propre serveur, où vous
#      êtes admin et où vit votre bot. C'est le contournement légitime.
#
# Lire avec le jeton de son compte UTILISATEUR (« self-bot ») est interdit par Discord,
# activement détecté, et sanctionné par le BANNISSEMENT. Non implémenté, et à ne pas
# implémenter — le compte perdu serait le vôtre.
#
# Le jeton est un SECRET : il ne sort jamais du .env, et le code le retire de tout
# message d'erreur avant de l'écrire (une URLError peut le porter).
#     make x-ingest ARGS="--source discord"
# DISCORD_BOT_TOKEN=<votre_jeton_de_bot>
# QUANT_DISCORD_SALONS=<id_du_salon>:eliz883,<autre_id>:astekz
#
# SI LE SALON N'EST NI LE VÔTRE NI UN SALON D'ANNONCES, le bot ne peut PAS y entrer et
# il n'existe aucune voie propre par l'API. Reste l'export navigateur — vous êtes déjà
# membre, déjà connecté, déjà en train de lire :
#     make x-export ARGS=--discord
# Discord ne rend que la zone visible : l'export capture ce que vous avez fait défiler.
# Remonter puis réexporter complète le fichier, sans rien dupliquer.
